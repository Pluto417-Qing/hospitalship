page {
  background: #f5f5f5;
}

.home-page {
  min-height: 100vh;
  padding-bottom: calc(136rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
  box-sizing: border-box;
}

.hero {
  position: relative;
  height: 574rpx;
  overflow: hidden;
  background: #d7d7d7;
}

.hero-swiper,
.hero-slide,
.hero-image,
.hero-image-placeholder {
  width: 100%;
  height: 100%;
}

.hero-image-placeholder {
  background: #d7d7d7;
}

.hero-top-scrim {
  position: absolute;
  top: -96rpx;
  left: -14rpx;
  z-index: 8;
  width: 770rpx;
  height: 286rpx;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.61) 0%,
    rgba(0, 0, 0, 0.36) 32.7%,
    rgba(0, 0, 0, 0.2) 84.6%,
    rgba(0, 0, 0, 0) 100%
  );
  pointer-events: none;
}

.hero-indicators {
  position: absolute;
  right: 0;
  bottom: 17rpx;
  left: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.hero-indicator {
  width: 12rpx;
  height: 6rpx;
  background: rgba(255, 255, 255, 0.68);
  border-radius: 999rpx;
}

.hero-indicator.is-active {
  width: 18rpx;
  background: #ffffff;
}

.custom-nav {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 10;
  padding-left: 38rpx;
  padding-right: 210rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.32);
}

.nav-title {
  display: flex;
  align-items: center;
}

.nav-logo {
  width: 446rpx;
  height: 108rpx;
}

.content {
  padding: 46rpx 20rpx 24rpx;
}

.book-shell {
  margin-bottom: 36rpx;
  padding: 28rpx 22rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 13rpx rgba(0, 0, 0, 0.2);
}

.book-card {
  min-height: 320rpx;
  padding: 24rpx 24rpx 16rpx;
  border-radius: 14rpx;
  display: flex;
  overflow: hidden;
}

.rehab-card {
  background: #b09cd1;
}

.summary-card {
  background: #9ed0ea;
}

.book-cover {
  width: 352rpx;
  height: 280rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.book-cover-placeholder {
  background: rgba(255, 255, 255, 0.18);
}

.book-cover-image {
  display: block;
  width: 100%;
  height: 100%;
}

.book-info {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 44rpx 0 0 32rpx;
  color: #ffffff;
}

.book-name {
  font-family: "PingFang SC", STKaiti, KaiTi, serif;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 58rpx;
  white-space: nowrap;
}

.book-subtitle {
  margin-top: 0;
  padding-left: 18rpx;
  font-family: "PingFang SC", STKaiti, KaiTi, serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 58rpx;
  white-space: nowrap;
}

.book-link {
  position: absolute;
  right: 2rpx;
  bottom: 0;
  font-family: Roboto, "PingFang SC", sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
}
