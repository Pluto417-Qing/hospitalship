page {
  background: #f3f3f3;
}

.home-page {
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #f3f3f3;
  box-sizing: border-box;
}

.hero {
  position: relative;
  height: 574rpx;
  overflow: hidden;
  background: #d7d7d7;
}

.hero-swiper,
.hero-slide,
.hero-image,
.hero-image-placeholder {
  width: 100%;
  height: 100%;
}

.hero-image-placeholder {
  background: #d7d7d7;
}

.hero-indicators {
  position: absolute;
  right: 0;
  bottom: 18rpx;
  left: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.hero-indicator {
  width: 24rpx;
  height: 5rpx;
  background: rgba(255, 255, 255, 0.68);
  border-radius: 999rpx;
}

.hero-indicator.is-active {
  width: 30rpx;
  background: #ffffff;
}

.custom-nav {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 10;
  padding-left: 38rpx;
  padding-right: 210rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.32);
}

.nav-title {
  display: flex;
  align-items: center;
}

.nav-logo {
  width: 420rpx;
}

.content {
  padding: 38rpx 28rpx 24rpx;
}

.book-shell {
  margin-bottom: 34rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.14);
}

.book-card {
  padding: 22rpx;
  border-radius: 24rpx;
  display: flex;
  overflow: hidden;
}

.rehab-card {
  background: #b09cd1;
}

.summary-card {
  background: #9ecce9;
}

.book-cover {
  width: 55%;
  height: 270rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.book-cover-placeholder {
  background: rgba(255, 255, 255, 0.18);
}

.book-cover-image {
  display: block;
  width: 100%;
  height: 100%;
}

.book-info {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 28rpx 10rpx 12rpx 34rpx;
  color: #ffffff;
}

.book-name {
  font-size: 34rpx;
  font-weight: 600;
  white-space: nowrap;
}

.book-subtitle {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.book-link {
  position: absolute;
  right: 4rpx;
  bottom: 6rpx;
  font-size: 28rpx;
}

.arrow {
  margin-left: 8rpx;
  font-size: 36rpx;
}
