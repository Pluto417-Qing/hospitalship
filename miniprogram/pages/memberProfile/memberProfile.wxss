page {
  background: #f5f6f6;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.state-card,
.info-card {
  background: #ffffff;
  border: 2rpx solid #8bcfbd;
  border-radius: 12rpx;
}

.state-card {
  margin-top: 120rpx;
  padding: 42rpx 28rpx;
  color: #6e7975;
  font-size: 25rpx;
  text-align: center;
}

.profile-header {
  padding: 26rpx 0 34rpx;
  text-align: center;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 16rpx;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 92rpx;
  background: #397ca9;
  border-radius: 10rpx;
}

.nickname {
  color: #303936;
  font-size: 34rpx;
  font-weight: 600;
}

.member-label {
  margin-top: 7rpx;
  color: #7d8884;
  font-size: 21rpx;
}

.info-card {
  padding: 0 22rpx;
}

.info-row {
  min-height: 88rpx;
  border-bottom: 1rpx solid #e0e7e4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.last-row {
  border-bottom: 0;
}

.info-label {
  color: #4e5955;
  font-size: 24rpx;
  flex-shrink: 0;
}

.info-value {
  margin-left: 24rpx;
  color: #747f7b;
  font-size: 22rpx;
  text-align: right;
}

.member-id {
  word-break: break-all;
}

.action-button {
  height: 76rpx;
  margin-top: 30rpx;
  padding: 0;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  background: #2b9a7c;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel {
  margin-top: 18rpx;
  background: #ffffff;
  border: 2rpx solid #8bcfbd;
  border-radius: 11rpx;
  overflow: hidden;
  box-shadow: 0 5rpx 12rpx rgba(27, 95, 76, 0.05);
}

.member-menu-item {
  min-height: 78rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #d9e8e3;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-menu-item:last-child {
  border-bottom: 0;
}

.member-menu-label {
  color: #333b39;
  font-size: 24rpx;
}

.member-menu-arrow {
  color: #98a4a1;
  font-size: 38rpx;
  line-height: 1;
}

.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-rules-dialog {
  width: 620rpx;
  padding: 28rpx 28rpx 20rpx;
  background: #ffffff;
  border-radius: 11rpx;
}

.dialog-title {
  color: #333b39;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.dialog-divider {
  height: 2rpx;
  margin-top: 20rpx;
  background: #59b69d;
}

.dialog-empty-tip {
  padding: 18rpx 14rpx 10rpx;
  color: #87918e;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.member-rules-scroll {
  height: 496rpx;
  padding-right: 4rpx;
}

.member-rule-item {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
}

.member-rule-number {
  width: 54rpx;
  height: 42rpx;
  margin-right: 16rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-align: center;
  background: #2b9a7c;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.member-rule-copy {
  min-width: 0;
  flex: 1;
}

.member-rule-title {
  margin-bottom: 7rpx;
  color: #25735e;
  font-size: 26rpx;
  font-weight: 600;
}

.member-rule-paragraph {
  color: #59635f;
  font-size: 24rpx;
  line-height: 1.75;
  text-align: justify;
}

.dialog-button {
  height: 62rpx;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 62rpx;
  background: #2b9a7c;
  border-radius: 999rpx;
}
