page {
  background: #f5f6f6;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.state-card {
  background: #ffffff;
  border: 2rpx solid #8bcfbd;
  border-radius: 12rpx;
  margin-top: 120rpx;
  padding: 42rpx 28rpx;
  color: #6e7975;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.menu-list {
  background: #ffffff;
  border-radius: 12rpx;
  overflow: hidden;
}

.menu-item {
  min-height: 100rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #d9e8e3;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-label {
  color: #333333;
  font-size: 32rpx;
  font-weight: 700;
}

.menu-arrow {
  color: #b0b0b0;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.menu-value {
  color: #666666;
  font-size: 32rpx;
  font-weight: 700;
}

.info-item {
  pointer-events: none;
}

.logout-button {
  height: 88rpx;
  margin-top: 40rpx;
  padding: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  background: #2b9a7c;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-button {
  height: 76rpx;
  padding: 0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  background: #2b9a7c;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-rules-dialog {
  width: 620rpx;
  padding: 28rpx 28rpx 20rpx;
  background: #ffffff;
  border-radius: 11rpx;
}

.dialog-title {
  color: #333b39;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.dialog-divider {
  height: 2rpx;
  margin-top: 20rpx;
  background: #59b69d;
}

.dialog-empty-tip {
  padding: 18rpx 14rpx 10rpx;
  color: #87918e;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.6;
  text-align: center;
}

.member-rules-scroll {
  height: 496rpx;
  padding-right: 4rpx;
}

.member-rule-item {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
}

.member-rule-number {
  width: 54rpx;
  height: 42rpx;
  margin-right: 16rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  background: #2b9a7c;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.member-rule-copy {
  min-width: 0;
  flex: 1;
}

.member-rule-title {
  margin-bottom: 7rpx;
  color: #25735e;
  font-size: 26rpx;
  font-weight: 700;
}

.member-rule-paragraph {
  color: #59635f;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.75;
  text-align: justify;
}

.dialog-button {
  height: 62rpx;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 62rpx;
  background: #2b9a7c;
  border-radius: 999rpx;
}
