page {
  background: #f5f6f6;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.state-card,
.info-card {
  background: #ffffff;
  border: 2rpx solid #8bcfbd;
  border-radius: 12rpx;
}

.state-card {
  margin-top: 120rpx;
  padding: 42rpx 28rpx;
  color: #6e7975;
  font-size: 25rpx;
  text-align: center;
}

.profile-header {
  padding: 26rpx 0 34rpx;
  text-align: center;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 16rpx;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 92rpx;
  background: #397ca9;
  border-radius: 10rpx;
}

.nickname {
  color: #303936;
  font-size: 34rpx;
  font-weight: 600;
}

.member-label {
  margin-top: 7rpx;
  color: #7d8884;
  font-size: 21rpx;
}

.info-card {
  padding: 0 22rpx;
}

.info-row {
  min-height: 88rpx;
  border-bottom: 1rpx solid #e0e7e4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.last-row {
  border-bottom: 0;
}

.info-label {
  color: #4e5955;
  font-size: 24rpx;
  flex-shrink: 0;
}

.info-value {
  margin-left: 24rpx;
  color: #747f7b;
  font-size: 22rpx;
  text-align: right;
}

.member-id {
  word-break: break-all;
}

.action-button {
  height: 76rpx;
  margin-top: 30rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
  background: #2b9a7c;
  border-radius: 999rpx;
}
