<view class="page">
  <view wx:if="{{loading}}" class="state-card">正在读取个人信息...</view>
  <view wx:elif="{{loadError}}" class="state-card">
    <view>{{loadError}}</view>
    <button class="action-button" bindtap="retryLoad">重新加载</button>
  </view>
  <block wx:elif="{{user}}">
    <view class="profile-header">
      <view class="avatar">船</view>
      <view class="nickname">{{user.nickname}}</view>
      <view class="member-label">少年会员</view>
    </view>

    <view class="info-card">
      <view class="info-row">
        <text class="info-label">会员编号</text>
        <text class="info-value member-id">{{user.memberId}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">会员代号</text>
        <text class="info-value">{{user.nickname}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">出生年份</text>
        <text class="info-value">{{user.birthYear}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">注册县域</text>
        <text class="info-value">{{user.city}}</text>
      </view>
      <view class="info-row last-row">
        <text class="info-label">监护人手机号</text>
        <text class="info-value">{{user.phoneMasked || "暂未获取"}}</text>
      </view>
    </view>

    <button class="action-button" bindtap="goSettings">账号设置</button>

    <view class="panel member-menu-panel">
      <view class="member-menu-item" data-name="会员消息" bindtap="showPending">
        <text class="member-menu-label">会员消息</text>
        <text class="member-menu-arrow">›</text>
      </view>
      <view class="member-menu-item" bindtap="showMemberRules">
        <text class="member-menu-label">会员规则</text>
        <text class="member-menu-arrow">›</text>
      </view>
    </view>
  </block>

  <view
    wx:if="{{memberRulesVisible}}"
    class="dialog-mask"
    bindtap="hideMemberRules"
  >
    <view class="member-rules-dialog" catchtap="stopPropagation">
      <view class="dialog-title">会员规则</view>
      <view class="dialog-divider"></view>
      <view class="dialog-empty-tip">
        这就是注册时确认过的少年读者规则，供你随时查看。
      </view>
      <scroll-view class="member-rules-scroll" scroll-y enhanced show-scrollbar="true">
        <view class="member-rule-item" wx:for="{{registrationRules}}" wx:key="number">
          <view class="member-rule-number">{{item.number}}</view>
          <view class="member-rule-copy">
            <view class="member-rule-title">{{item.title}}</view>
            <view class="member-rule-paragraph">{{item.paragraph}}</view>
          </view>
        </view>
      </scroll-view>
      <button class="dialog-button" bindtap="hideMemberRules">知道了</button>
    </view>
  </view>
</view>
