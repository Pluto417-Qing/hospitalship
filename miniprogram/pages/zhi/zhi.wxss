page {
  background: #faf9f7; /* 暖白色，更符合设计稿 */
}

.timeline-page {
  min-height: 100vh;
  padding: 30rpx 26rpx calc(164rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #faf9f7; /* 与page背景一致 */
}

.date-heading {
  min-height: 72rpx;
  padding: 0 26rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.year-trigger {
  color: #7550b9;
  display: flex;
  align-items: center;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1;
}

.year-chevron {
  margin: -8rpx 0 0 12rpx;
  color: #4e4e4e;
  font-size: 40rpx;
  font-weight: 400;
}

.selected-month {
  margin-left: 14rpx;
  font-size: 36rpx;
  font-weight: 500;
}

.timeline-list {
  position: relative;
  padding: 12rpx 0 0 58rpx;
}

.timeline-list::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 29rpx;
  width: 2rpx;
  background: repeating-linear-gradient(
    to bottom,
    #c3a2ec 0,
    #c3a2ec 14rpx,
    transparent 14rpx,
    transparent 24rpx
  );
  content: "";
}

.timeline-item {
  position: relative;
  margin-bottom: 24rpx;
}

.timeline-node {
  position: absolute;
  top: 165rpx;
  left: -38rpx;
  width: 20rpx;
  height: 20rpx;
  background: #bc91e8;
  border: 5rpx solid #faf9f7; /* 与页面背景色一致 */
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.message-card {
  min-height: 330rpx;
  padding: 30rpx 28rpx 28rpx;
  background: #ffffff;
  border: 6rpx solid #b997f0;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(87, 57, 125, 0.03); /* 更柔和的阴影 */
}

.message-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.message-date {
  flex: 0 0 174rpx;
  color: #714bb3;
  display: flex;
  align-items: center;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.message-date-text {
  display: inline-block;
  flex-shrink: 0;
  line-height: 1;
  white-space: nowrap;
}

.flag {
  width: 34rpx;
  height: 34rpx;
  margin-left: 6rpx;
  flex-shrink: 0;
}

.message-source {
  max-width: 380rpx;
  color: #7350b5;
  font-size: 36rpx;
  line-height: 1;
  text-align: right;
  word-wrap: break-word;
}

.message-content {
  margin-top: 24rpx;
  color: #333333; /* 黑色，符合设计稿要求 */
  font-size: 34rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.empty-card {
  margin: 120rpx 28rpx 0;
  padding: 52rpx 36rpx;
  background: #ffffff;
  border: 4rpx solid #b28ae5;
  border-radius: 20rpx;
  text-align: center;
}

.empty-title {
  color: #6945a6;
  font-size: 40rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 18rpx;
  color: #85808b;
  font-size: 32rpx;
  line-height: 1.7;
}

.empty-btn {
  width: 240rpx;
  margin-top: 30rpx;
  color: #ffffff;
  background: #a77ce2;
  border-radius: 999rpx;
  font-size: 34rpx;
}

.picker-mask {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-sheet {
  position: relative;
  width: 750rpx;
  height: 670rpx;
  padding: 58rpx 20rpx 38rpx;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.picker-title {
  padding: 0 28rpx;
  color: #7850b8;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.date-picker {
  width: 702rpx;
  height: 190rpx;
  margin-left: 0;
  margin-top: 114rpx;
  background: linear-gradient(
    to bottom,
    transparent 0,
    transparent 46rpx,
    #f4f4f5 46rpx,
    #f4f4f5 144rpx,
    transparent 144rpx
  );
  border-radius: 12rpx;
}

.picker-item {
  height: 98rpx;
  color: #7552af;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.picker-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 38rpx;
  z-index: 10;
  height: 86rpx;
}

.picker-btn {
  position: absolute;
  top: 0;
  width: 212rpx;
  height: 86rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 82rpx;
  text-align: center;
}

.cancel-btn {
  left: 122rpx;
  color: #181818;
  background: #ffffff;
  border: 2rpx solid #b997f0;
}

.confirm-btn {
  left: 386rpx;
  color: #ffffff;
  background: #b997f0;
  border: 2rpx solid #b997f0;
}

.empty-btn::after {
  border: none;
}
