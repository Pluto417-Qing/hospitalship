<view class="timeline-page">
  <view class="date-heading">
    <view class="year-trigger" bindtap="openDatePicker">
      <text>{{selectedYear}}</text>
      <text wx:if="{{selectedMonth}}" class="selected-month">· {{selectedMonth}}月</text>
      <text class="year-chevron">⌄</text>
    </view>
  </view>

  <view class="timeline-list" wx:if="{{visibleEntries.length}}">
    <view
      class="timeline-item"
      wx:for="{{visibleEntries}}"
      wx:key="id"
    >
      <view class="timeline-node"></view>
      <view class="message-card">
        <view class="message-topline">
          <view class="message-date">
            <text class="message-date-text">{{item.month}}月{{item.day}}日</text>
            <image class="flag" src="/images/youth-red-flag.svg" mode="aspectFit" />
          </view>
          <view class="message-source">{{item.source}}</view>
        </view>
        <view class="message-content">{{item.content}}</view>
      </view>
    </view>
  </view>

  <view class="empty-card" wx:elif="{{timelineLoading}}">
    <view class="empty-title">正在读取已审核消息</view>
    <view class="empty-desc">请稍候。</view>
  </view>

  <view class="empty-card" wx:else>
    <view class="empty-title">该月份暂无消息</view>
    <view class="empty-desc">试试查看全年，或选择其他年月。</view>
    <button class="empty-btn" bindtap="clearMonthFilter">查看全年</button>
  </view>

  <view
    wx:if="{{datePickerVisible}}"
    class="picker-mask"
    bindtap="cancelDatePicker"
  >
    <view class="picker-sheet" catchtap="stopPropagation">
      <view class="picker-title">请选择日期</view>
      <picker-view
        class="date-picker"
        value="{{draftPickerValue}}"
        indicator-style="height: 98rpx;"
        bindchange="onPickerChange"
      >
        <picker-view-column>
          <view class="picker-item" wx:for="{{yearOptions}}" wx:key="*this">
            {{item}}
          </view>
        </picker-view-column>
        <picker-view-column>
          <view class="picker-item" wx:for="{{monthOptions}}" wx:key="*this">
            {{item}}
          </view>
        </picker-view-column>
      </picker-view>
      <cover-view class="picker-actions">
        <cover-view class="picker-btn cancel-btn" bindtap="cancelDatePicker">取消</cover-view>
        <cover-view class="picker-btn confirm-btn" bindtap="confirmDatePicker">确定</cover-view>
      </cover-view>
    </view>
  </view>
</view>
