page {
  background: #f4f4f4;
}

.text-page {
  height: 100vh;
  padding: 30rpx 34rpx;
  box-sizing: border-box;
}

.text-card {
  height: calc(100vh - 60rpx);
  padding: 42rpx 36rpx 48rpx;
  background: #ffffff;
  border: 2rpx solid #cc411a;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.text-title {
  color: #222222;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
}

.text-section {
  margin-top: 28rpx;
}

.section-title {
  display: none;
}

.text-paragraph {
  margin-bottom: 20rpx;
  color: #282828;
  font-size: 28rpx;
  line-height: 1.95;
  text-align: justify;
  text-indent: 2em;
}

.text-paragraph.is-authors {
  text-indent: 0;
}

.inline-image-card {
  width: 100%;
  margin: 26rpx 0 30rpx;
}

.inline-image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 10rpx;
  background: #f2f2f2;
}

.inline-image-caption {
  margin-top: 12rpx;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.health-note {
  margin-top: 28rpx;
  color: #555555;
  font-size: 24rpx;
  line-height: 1.8;
  text-align: justify;
}
