page {
  background: #ffffff;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    Helvetica, "Microsoft YaHei", sans-serif;
}

.topic-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.topic-intro,
.state-card,
.topic-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(88, 47, 34, 0.08);
}

.topic-intro {
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-top: 8rpx solid #d94432;
}

.topic-intro-title {
  color: #f5714f;
  font-size: 52rpx;
  font-weight: 700;
}

.topic-intro-copy {
  margin-top: 14rpx;
  color: #6f625d;
  font-size: 36rpx;
  line-height: 1.7;
}

.state-card {
  padding: 60rpx 30rpx;
  color: #756a66;
  font-size: 38rpx;
  line-height: 1.6;
  text-align: center;
}

.state-card.error {
  color: #a5372d;
}

.retry-btn {
  width: 220rpx;
  margin-top: 24rpx;
  color: #ffffff;
  background: #d94432;
  border-radius: 999rpx;
  font-size: 36rpx;
}

.retry-btn::after {
  border: 0;
}

.topic-card {
  position: relative;
  min-height: 165rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid #f5714f;
  border-radius: 24rpx;
  box-shadow: none;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: auto 1fr;
  column-gap: 20rpx;
  row-gap: 8rpx;
  align-items: center;
}

.topic-meta {
  grid-column: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.topic-cover {
  display: none; /* 隐藏封面图 */
}

.topic-cover.placeholder {
  display: none; /* 隐藏封面图 */
}

.topic-number {
  flex-shrink: 0;
  color: #f5714f;
  font-size: 44rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
  line-height: 1.2;
}

.topic-title {
  color: #1a1a1a;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 60rpx;
}

/* 已移除第二行，状态标签并入第一行 */

.topic-producer {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 60rpx;
  padding-left: 20rpx;
}

.topic-summary {
  display: none; /* 隐藏简介 */
}

.topic-status {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  color: #ffffff;
  background: #a78bfa;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.topic-status.unlocked {
  color: #ffffff;
  background: #f5714f;
}

.loading-more {
  padding: 20rpx;
  color: #887a75;
  font-size: 34rpx;
  text-align: center;
}
