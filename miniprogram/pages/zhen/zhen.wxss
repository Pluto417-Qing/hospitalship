page {
  background: #faf8f5; /* 暖色调，符合设计要求 */
}

.topic-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.topic-intro,
.state-card,
.topic-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(88, 47, 34, 0.08);
}

.topic-intro {
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-top: 8rpx solid #d94432;
}

.topic-intro-title {
  color: #8f251c;
  font-size: 52rpx;
  font-weight: 700;
}

.topic-intro-copy {
  margin-top: 14rpx;
  color: #6f625d;
  font-size: 36rpx;
  line-height: 1.7;
}

.state-card {
  padding: 60rpx 30rpx;
  color: #756a66;
  font-size: 38rpx;
  line-height: 1.6;
  text-align: center;
}

.state-card.error {
  color: #a5372d;
}

.retry-btn {
  width: 220rpx;
  margin-top: 24rpx;
  color: #ffffff;
  background: #d94432;
  border-radius: 999rpx;
  font-size: 36rpx;
}

.retry-btn::after {
  border: 0;
}

.topic-card {
  position: relative;
  min-height: auto;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid #d94432; /* 柿色外框，符合设计稿要求 */
  border-radius: 20rpx;
  box-sizing: border-box;
}

.topic-cover {
  display: none; /* 隐藏封面图 */
}

.topic-cover.placeholder {
  display: none; /* 隐藏封面图 */
}

.topic-copy {
  width: 100%;
  padding: 0 120rpx 0 0; /* 右侧留出按钮空间 */
}

.topic-number {
  color: #d94432;
  font-size: 56rpx;
  letter-spacing: 2rpx;
  font-weight: 700;
  line-height: 1.2;
}

.topic-title {
  margin-top: 6rpx;
  color: #333333; /* 黑色，符合设计稿要求 */
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.topic-producer {
  margin-top: 12rpx;
  color: #666666;
  font-size: 28rpx;
  line-height: 1.5;
}

.topic-summary {
  display: none; /* 隐藏简介 */
}

.topic-status {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx 20rpx;
  color: #7550b9; /* 紫色文字 */
  background: #f0e8ff; /* 浅紫色背景 */
  border-radius: 999rpx;
  font-size: 28rpx;
}

.topic-status.unlocked {
  color: #d94432; /* 柿色文字 */
  background: #fde9e6; /* 浅柿色背景 */
}

.loading-more {
  padding: 20rpx;
  color: #887a75;
  font-size: 34rpx;
  text-align: center;
}
