page {
  background: #faf8f5; /* 暖色调，符合设计要求 */
}

.topic-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.topic-intro,
.state-card,
.topic-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(88, 47, 34, 0.08);
}

.topic-intro {
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-top: 8rpx solid #d94432;
}

.topic-intro-title {
  color: #8f251c;
  font-size: 52rpx;
  font-weight: 700;
}

.topic-intro-copy {
  margin-top: 14rpx;
  color: #6f625d;
  font-size: 36rpx;
  line-height: 1.7;
}

.state-card {
  padding: 60rpx 30rpx;
  color: #756a66;
  font-size: 38rpx;
  line-height: 1.6;
  text-align: center;
}

.state-card.error {
  color: #a5372d;
}

.retry-btn {
  width: 220rpx;
  margin-top: 24rpx;
  color: #ffffff;
  background: #d94432;
  border-radius: 999rpx;
  font-size: 36rpx;
}

.retry-btn::after {
  border: 0;
}

.topic-card {
  position: relative;
  min-height: auto;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid #f5a396; /* 浅柿色外框 */
  border-radius: 16rpx;
  box-sizing: border-box;
}

.topic-cover {
  display: none; /* 隐藏封面图 */
}

.topic-cover.placeholder {
  display: none; /* 隐藏封面图 */
}

/* 第一行：编号 + 标题 */
.topic-row-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.topic-number {
  flex-shrink: 0;
  color: #f5714f;
  font-size: 44rpx;
  letter-spacing: 1rpx;
  font-weight: 500;
  line-height: 1.2;
}

.topic-title {
  flex: 1;
  min-width: 0;
  color: #f5714f;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.3;
}

/* 第二行：制作单位 + 状态按钮 */
.topic-row-bottom {
  margin-top: 12rpx;
  padding-left: 76rpx; /* 与标题左对齐 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.topic-producer {
  flex: 1;
  min-width: 0;
  color: #333333;
  font-size: 30rpx;
  line-height: 1.4;
}

.topic-summary {
  display: none; /* 隐藏简介 */
}

.topic-status {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  color: #ffffff;
  background: #a78bfa; /* 紫色背景 - 未下载 */
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.4;
}

.topic-status.unlocked {
  color: #ffffff;
  background: #f5a396; /* 柿色背景 - 已下载 */
}

.loading-more {
  padding: 20rpx;
  color: #887a75;
  font-size: 34rpx;
  text-align: center;
}
