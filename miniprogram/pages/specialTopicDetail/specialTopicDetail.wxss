page {
  background: #f7f4f1;
}

.detail-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 70rpx;
  box-sizing: border-box;
}

.state-card,
.topic-heading,
.entry-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(88, 47, 34, 0.08);
}

.state-card {
  padding: 70rpx 34rpx;
  color: #756a66;
  font-size: 29rpx;
  line-height: 1.7;
  text-align: center;
}

.state-card.error {
  color: #a5372d;
}

.retry-btn {
  width: 220rpx;
  margin-top: 26rpx;
  color: #ffffff;
  background: #d94432;
  border-radius: 999rpx;
  font-size: 27rpx;
}

.retry-btn::after {
  border: 0;
}

.topic-heading {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border-top: 8rpx solid #d94432;
}

.topic-title {
  color: #382c28;
  font-family: STKaiti, KaiTi, serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.45;
}

.topic-producer,
.topic-summary {
  margin-top: 14rpx;
  color: #786a65;
  font-size: 26rpx;
  line-height: 1.7;
}

.unlock-notice {
  display: inline-block;
  margin-top: 22rpx;
  padding: 9rpx 18rpx;
  color: #a7352c;
  background: #fde9e6;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.entry-card {
  padding: 34rpx 30rpx;
  margin-bottom: 24rpx;
}

.content-heading {
  margin: 10rpx 0 24rpx;
  color: #8f251c;
  font-size: 35rpx;
  font-weight: 700;
  line-height: 1.5;
}

.content-text {
  margin: 0 0 24rpx;
  color: #3f3734;
  font-size: 29rpx;
  line-height: 1.95;
  white-space: pre-wrap;
}

.content-image-wrap {
  margin: 28rpx 0;
}

.content-image {
  display: block;
  width: 100%;
  border-radius: 18rpx;
  background: #f2eeec;
}

.image-caption {
  margin-top: 12rpx;
  color: #887a75;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.content-state {
  margin: 16rpx 0 10rpx;
  padding: 28rpx 24rpx;
  color: #887a75;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.content-state.error {
  color: #a5372d;
  background: #fff0ed;
  border-radius: 20rpx;
}

.content-state.complete {
  color: #9a8f8a;
}

.content-retry-btn,
.load-more-btn {
  width: 230rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  line-height: 2.3;
}

.content-retry-btn {
  color: #ffffff;
  background: #d94432;
}

.load-more-btn {
  color: #a7352c;
  background: #fde9e6;
}

.content-retry-btn::after,
.load-more-btn::after {
  border: 0;
}
