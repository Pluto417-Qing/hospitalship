<view class="page">
  <view class="menu-list">
    <view class="menu-item" bindtap="goProfile">
      <text class="menu-label">个人信息</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" data-name="会员消息" bindtap="showPending">
      <text class="menu-label">会员消息</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" data-name="小组件" bindtap="showPending">
      <text class="menu-label">小组件</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item phone-row">
      <text class="menu-label">手机号</text>
      <text class="phone">{{phone || "暂未获取"}}</text>
    </view>

    <view wx:if="{{canAddMember}}" class="menu-item" bindtap="goAddMember">
      <text class="menu-label">新增少年会员</text>
      <text class="menu-arrow">›</text>
    </view>

    <view wx:if="{{canManageUploads}}" class="menu-item admin-menu-item" bindtap="goAdminUploads">
      <view class="admin-menu-copy">
        <text class="menu-label admin-menu-label">管理员内容中心</text>
        <text class="admin-menu-hint">上传、草稿、复核与发布按权限分别处理</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="logout-button" bindtap="switchMember">切换会员</button>
</view>
