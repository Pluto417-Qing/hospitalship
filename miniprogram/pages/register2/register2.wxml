<view class="page">
  <view class="page-heading">少年读者规则</view>

  <view class="step-bar" aria-label="注册进度：第二步，共三步">
    <view class="step"></view>
    <view class="step active"></view>
    <view class="step"></view>
  </view>

  <view class="document-card">
    <scroll-view class="document-scroll" scroll-y enhanced show-scrollbar="false">
      <view class="document-title">《中国医院船》少年读者规则</view>
      <view class="document-lead">
        愿每一次阅读都带来知识、善意与成长。使用少年会员服务时，请共同遵守以下约定。
      </view>

      <view class="rule-item" wx:for="{{registrationRules}}" wx:key="number">
        <view class="rule-number">{{item.number}}</view>
        <view class="rule-copy">
          <view class="rule-title">{{item.title}}</view>
          <view class="paragraph">{{item.paragraph}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="agree-row" bindtap="toggleAgree">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="check-symbol">✓</text>
      </view>
      <text class="agree-text">我和监护人已认真阅读，同意并遵守上述少年读者规则</text>
    </view>
  </view>

  <view class="button-row">
    <button class="previous-button" bindtap="goPrev">上一步</button>
    <button class="next-button" bindtap="goNext">下一步</button>
  </view>
</view>
