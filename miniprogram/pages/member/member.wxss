page {
  --page-font-scale: 1.2;
  background: #f5f6f6;
}

.page {
  min-height: 100vh;
  padding: 18rpx 24rpx calc(142rpx + env(safe-area-inset-bottom));
}

.state-card {
  margin-top: 180rpx;
  padding: 54rpx 36rpx;
  background: #ffffff;
  border: 2rpx solid #8bcfbd;
  border-radius: 14rpx;
  text-align: center;
}

.register-state {
  width: 100%;
  min-height: 610rpx;
  margin: 16rpx auto 0;
  padding: 58rpx 36rpx 56rpx;
}

.state-avatar {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto 24rpx;
  color: #ffffff;
  font-size: calc(34rpx * var(--page-font-scale));
  line-height: 84rpx;
  background: #2b9a7c;
  border-radius: 10rpx;
}

.state-title {
  color: #303836;
  font-size: calc(32rpx * var(--page-font-scale));
  font-weight: 600;
}

.state-desc {
  margin-top: 18rpx;
  color: #7c8683;
  font-size: calc(24rpx * var(--page-font-scale));
  line-height: 1.7;
}

.state-button {
  width: 384rpx;
  height: 76rpx;
  margin: 34rpx auto 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: calc(27rpx * var(--page-font-scale));
  line-height: 1.2;
  background: #2b9a7c;
  border-radius: 999rpx;
}

.state-button-secondary {
  margin-top: 18rpx;
  color: #2b9a7c;
  background: #ffffff;
  border: 2rpx solid #2b9a7c;
}
.member-header {
  min-height: 94rpx;
  padding: 8rpx 8rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-identity {
  display: flex;
  align-items: center;
}

.member-avatar {
  /* 头像容器，正方形，和原来文字头像尺寸保持一致 */
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx; /* 如果想要圆形改成 50% */
  overflow: hidden;
  margin-right: 20rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.member-name {
  font-size: 32rpx;
}

.header-arrow {
  color: #999;
  font-size: 32rpx;
}

.member-copy {
  min-width: 0;
}

.member-name {
  color: #2b3331;
  font-size: calc(29rpx * var(--page-font-scale));
  font-weight: 600;
  line-height: 1.35;
}

.header-arrow {
  padding: 12rpx;
  color: #8d9693;
  font-size: calc(50rpx * var(--page-font-scale));
  line-height: 1;
}

.search-box {
  height: 60rpx;
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 2rpx solid #73c4ae;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.search-icon {
  color: #4d5b57;
  font-size: calc(60rpx * var(--page-font-scale));
  line-height: 1;
  display: flex;
  align-items: center;
  height: 100%;
  transform: scaleX(-1);
}

.panel {
  margin-bottom: 18rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 2rpx solid #8bcfbd;
  border-radius: 11rpx;
  box-shadow: 0 5rpx 12rpx rgba(27, 95, 76, 0.05);
}

.star-panel {
  padding: 28rpx 30rpx 30rpx;
  border: 1rpx solid #2b9a7c;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.09);
}

.panel-title {
  color: #000000;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.badge-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17rpx 8rpx;
}

.badge-item {
  min-width: 0;
  text-align: center;
}

.badge-circle {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto;
  background: #fbfdfc;
  border: 2rpx solid #65bfa7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-item.earned .badge-circle {
  background: #e8f7f2;
}

.badge-star {
  color: #df4038;
  font-size: calc(36rpx * var(--page-font-scale));
  line-height: 1;
}

.badge-name {
  width: 100%;
  margin-top: 5rpx;
  color: #838d8a;
  font-size: calc(23rpx * var(--page-font-scale));
  line-height: 1.35;
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-weight: bold; /* 新增加粗 */
}

.star-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.star-card {
  height: 148rpx;
  color: #ffffff;
  background: #2b9a7c;
  border: 1rpx solid #2b9a7c;
  border-radius: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.red-star {
  color: #e13d36;
  font-size: 56rpx;
  line-height: 1;
}

/* image version size */
.red-star[mode] {
  width: 58rpx;
  height: 56rpx;
  margin-top: 18rpx;
}

.star-text {
  width: 100%;
  margin-top: 4rpx;
  color: #ffffff;
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}

.star-label {
  font-size: calc(23rpx * var(--page-font-scale));
}

.star-number {
  font-size: 40rpx;
  line-height: 1;
}

.family-actions {
  margin-top: 16rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.small-button {
  width: 250rpx;
  min-width: 210rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 12rpx;
  color: #ffffff;
  font-size: calc(25rpx * var(--page-font-scale));
  line-height: 1.2;
  background: #2b9a7c;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 280rpx;
  white-space: nowrap;
  text-align: center;
}

.small-button[disabled] {
  color: #ffffff;
  background: #2b9a7c;
  opacity: 0.62;
}

.notes-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-notice {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  color: #9a5b18;
  font-size: calc(20rpx * var(--page-font-scale));
  line-height: 1.55;
  background: #fff7e8;
  border: 1rpx solid #efc98d;
  border-radius: 6rpx;
}

.revision-required-notice {
  color: #a33b2b;
}

.collapse-link {
  padding: 6rpx 10rpx;
  color: #2b9877;
  font-size: calc(20rpx * var(--page-font-scale));
}

.password-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
}

.password-label {
  color: #555f5c;
  font-size: calc(25rpx * var(--page-font-scale));
  flex-shrink: 0;
}

.password-input {
  min-width: 0;
  height: 48rpx;
  margin-left: 8rpx;
  padding: 0 12rpx;
  color: #333b39;
  font-size: calc(23rpx * var(--page-font-scale));
  background: #ffffff;
  border: 1rpx solid #d8e0de;
  border-radius: 4rpx;
  flex: 1;
}

.confirm-button {
  width: 120rpx;
  min-width: 140rpx;
  height: 48rpx;
  margin: 0 0 0 12rpx;
  padding: 0;
  color: #ffffff;
  font-size: calc(25rpx * var(--page-font-scale));
  line-height: 1;
  background: #288f70;
  border-radius: 5rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 96rpx;
}

.inline-notes {
  margin-top: 12rpx;
}

.inline-note {
  padding: 12rpx 2rpx 10rpx;
  border-bottom: 1rpx solid #b8dcd2;
}

.inline-note-title {
  color: #37413e;
  font-size: calc(21rpx * var(--page-font-scale));
  font-weight: 600;
}

.inline-note-content {
  max-height: 62rpx;
  margin-top: 6rpx;
  color: #747e7b;
  font-size: calc(19rpx * var(--page-font-scale));
  line-height: 31rpx;
  overflow: hidden;
}

.expand-notes {
  padding: 18rpx 0 4rpx;
  color: #2b9a7c;
  font-size: calc(20rpx * var(--page-font-scale));
  text-align: center;
}

.empty-notes {
  padding: 24rpx 0 10rpx;
  color: #8e9895;
  font-size: calc(21rpx * var(--page-font-scale));
  text-align: center;
}

.dialog-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.family-dialog {
  width: 620rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #ffffff;
  border-radius: 11rpx;
}

.member-rules-dialog {
  padding-bottom: 20rpx;
}

.family-list {
  height: 496rpx;
}

.member-rules-scroll {
  height: 520rpx;
  margin-top: 6rpx;
  padding-right: 4rpx;
}

.member-rules-lead {
  padding-top: 18rpx;
  padding-bottom: 12rpx;
}

.member-rule-item {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
}

.member-rule-number {
  width: 54rpx;
  height: 42rpx;
  margin-right: 16rpx;
  color: #ffffff;
  font-size: calc(20rpx * var(--page-font-scale));
  font-weight: 600;
  line-height: 42rpx;
  text-align: center;
  background: #2b9a7c;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.member-rule-copy {
  min-width: 0;
  flex: 1;
}

.member-rule-title {
  margin-bottom: 7rpx;
  color: #25735e;
  font-size: calc(26rpx * var(--page-font-scale));
  font-weight: 600;
}

.member-rule-paragraph {
  color: #59635f;
  font-size: calc(24rpx * var(--page-font-scale));
  line-height: 1.75;
  text-align: justify;
}

.dialog-title {
  color: #333b39;
  font-size: calc(27rpx * var(--page-font-scale));
  font-weight: 600;
  text-align: center;
}

.dialog-divider {
  height: 2rpx;
  margin-top: 20rpx;
  background: #59b69d;
}

.family-empty-row {
  min-height: 62rpx;
  padding: 0 8rpx;
  border-bottom: 1rpx solid #88c9b7;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.family-empty-name,
.family-empty-status {
  color: #59635f;
  font-size: calc(21rpx * var(--page-font-scale));
}

.family-empty-status {
  color: #2a8f71;
}

.dialog-empty-tip {
  padding: 24rpx 14rpx 8rpx;
  color: #87918e;
  font-size: calc(20rpx * var(--page-font-scale));
  line-height: 1.6;
  text-align: center;
}

.dialog-button {
  height: 62rpx;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: calc(23rpx * var(--page-font-scale));
  line-height: 62rpx;
  background: #2b9a7c;
  border-radius: 999rpx;
}
