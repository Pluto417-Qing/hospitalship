page {
  background: #f4f4f4;
}

.summary-page {
  min-height: 100vh;
  padding: 28rpx 34rpx 54rpx;
  box-sizing: border-box;
}

.summary-card {
  min-height: 162rpx;
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  color: #ffffff;
  border-radius: 14rpx;
  box-shadow: 0 10rpx 19rpx rgba(0, 0, 0, 0.13);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.summary-copy {
  min-width: 0;
  flex: 1;
}

.summary-meta {
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
}

.summary-title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.summary-status {
  margin-left: 20rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.summary-empty {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #8a8a8a;
}

.summary-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}
