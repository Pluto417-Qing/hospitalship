page {
  background: #f4f3f1;
  color: #303735;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 72rpx;
}

.intro-card,
.state-card,
.review-card,
.error-card {
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(55, 42, 37, 0.06);
}

.intro-card {
  padding: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #237d64 0%, #35a17f 100%);
}

.intro-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  letter-spacing: 4rpx;
}

.intro-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.intro-copy {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  line-height: 1.7;
}

.intro-actions {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-count,
.refresh-link {
  font-size: 23rpx;
}

.refresh-link {
  color: #1f8065;
  font-weight: 600;
}

.intro-card .refresh-link {
  color: #ffffff;
}

.state-card {
  min-height: 330rpx;
  margin-top: 24rpx;
  padding: 58rpx 42rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.state-spinner {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #d7e9e2;
  border-top-color: #2b9878;
  border-radius: 50%;
}

.state-mark,
.empty-mark {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  font-size: 40rpx;
  line-height: 72rpx;
  text-align: center;
  background: #b44a42;
  border-radius: 50%;
}

.empty-mark {
  background: #2b9878;
}

.state-title {
  color: #303735;
  font-size: 31rpx;
  font-weight: 700;
}

.state-copy {
  max-width: 540rpx;
  margin-top: 16rpx;
  color: #7c817e;
  font-size: 23rpx;
  line-height: 1.7;
}

.outline-button {
  width: 250rpx;
  height: 72rpx;
  margin-top: 32rpx;
  color: #2b9878;
  font-size: 24rpx;
  line-height: 70rpx;
  background: #ffffff;
  border: 2rpx solid #2b9878;
  border-radius: 36rpx;
}

.outline-button::after,
.review-button::after,
.load-more-button::after {
  border: 0;
}

.error-card {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #a64039;
  font-size: 23rpx;
  line-height: 1.6;
  border: 2rpx solid #efd7d3;
}

.review-list {
  margin-top: 24rpx;
}

.review-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.review-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.review-title {
  min-width: 0;
  flex: 1;
  color: #293431;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.review-category {
  max-width: 230rpx;
  margin-left: 18rpx;
  padding: 7rpx 14rpx;
  color: #a64039;
  font-size: 19rpx;
  line-height: 1.35;
  text-align: center;
  background: #fff0ed;
  border-radius: 18rpx;
}

.review-time {
  margin-top: 10rpx;
  color: #949a97;
  font-size: 20rpx;
}

.comment-box {
  margin-top: 22rpx;
  padding: 24rpx;
  color: #3c4441;
  font-size: 25rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  background: #f7f8f7;
  border-radius: 14rpx;
}

.review-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
}

.review-button {
  height: 74rpx;
  flex: 1;
  margin: 0;
  font-size: 24rpx;
  line-height: 74rpx;
  border-radius: 37rpx;
}

.reject-button {
  color: #a64039;
  background: #fff0ed;
}

.approve-button {
  color: #ffffff;
  background: #2b9878;
}

.review-button[disabled] {
  color: #ffffff;
  background: #aeb8b4;
}

.load-more-button {
  height: 76rpx;
  margin-top: 24rpx;
  color: #2b9878;
  font-size: 24rpx;
  line-height: 74rpx;
  background: #ffffff;
  border: 2rpx solid #d7e9e2;
  border-radius: 38rpx;
}
