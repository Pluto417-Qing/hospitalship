page {
  background: #f4f4f4;
}

.audio-page {
  min-height: 100vh;
  padding: 46rpx 34rpx 54rpx;
  box-sizing: border-box;
}

.audio-card {
  min-height: 1240rpx;
  padding: 70rpx 40rpx 48rpx;
  background: #ffffff;
  border: 2rpx solid #cc411a;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.audio-cover {
  width: 100%;
  height: 460rpx;
  background: #cfcfcf;
  border-radius: 12rpx;
}

.pending-badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 9rpx 16rpx;
  color: #ffffff;
  background: rgba(217, 65, 23, 0.9);
  border-radius: 999rpx;
  font-size: 21rpx;
}

.audio-title {
  margin-top: 78rpx;
  color: #202020;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.55;
}

.progress-track {
  position: relative;
  height: 4rpx;
  margin-top: 52rpx;
  background: #cfcfcf;
}

.progress-value {
  width: 20%;
  height: 100%;
  background: #222222;
}

.progress-dot {
  position: absolute;
  top: -7rpx;
  left: 20%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  background: #222222;
  border-radius: 50%;
}

.progress-meta {
  margin-top: 16rpx;
  color: #222222;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.audio-controls {
  margin-top: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 82rpx;
}

.skip-btn {
  color: #cfcfcf;
  font-size: 36rpx;
}

.play-btn {
  width: 92rpx;
  height: 92rpx;
  padding-left: 8rpx;
  color: #111111;
  font-size: 54rpx;
  line-height: 92rpx;
  text-align: center;
}

.audio-notice {
  margin-top: 72rpx;
  padding: 18rpx 20rpx;
  color: #8f6e62;
  background: #fff4ef;
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  text-align: center;
}
