page {
  background: linear-gradient(180deg, #f6f6f6 0%, #ffffff 100%);
}

.quiz-shell {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6f6f6 0%, #ffffff 100%);
  box-sizing: border-box;
}

.custom-navigation {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 1000;
  background: #ffffff;
  box-shadow: 0 -24rpx 61rpx rgba(0, 0, 0, 0.25);
}

.navigation-back {
  position: absolute;
  left: 0;
  width: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navigation-chevron {
  width: 20rpx;
  height: 20rpx;
  margin-left: 2rpx;
  border-bottom: 2rpx solid #000000;
  border-left: 2rpx solid #000000;
  transform: rotate(45deg);
}

.design-scrollbar {
  position: fixed;
  top: 230rpx;
  right: 14rpx;
  z-index: 20;
  width: 12rpx;
  height: 1218rpx;
  background: rgba(217, 217, 217, 0.48);
  border-radius: 18rpx;
  pointer-events: none;
}

.design-scrollbar-thumb {
  width: 12rpx;
  height: 166rpx;
  margin-top: 192rpx;
  background: #acacac;
  border-radius: 18rpx;
}

.quiz-page {
  min-height: 0;
  padding: 50rpx 38rpx calc(168rpx + env(safe-area-inset-bottom)) 42rpx;
  box-sizing: border-box;
}

/* 护眼提示 */
.eye-care-tip {
  margin-bottom: 30rpx;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #fff9e6 0%, #ffe8cc 100%);
  border-left: 6rpx solid #ffa726;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 167, 38, 0.1);
}

.eye-text {
  font-size: 30rpx;
  color: #d84315;
  line-height: 1.6;
}

.quiz-state,
.quiz-notice {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  color: #3c6f91;
  background: #eaf4fb;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.quiz-notice {
  color: #7a684d;
  background: #fff7df;
}

.quiz-empty {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #8a8a8a;
}

.quiz-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.quiz-empty-copy {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.question-card {
  position: relative;
  width: 670rpx;
  min-height: 420rpx;
  margin-bottom: 28rpx;
  padding: 150rpx 28rpx 36rpx;
  background: #ffffff;
  border: 2rpx solid #367dae;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.09);
  box-sizing: border-box;
}

.question-card.is-answer {
  min-height: 420rpx;
}

.question-header,
.answer-header {
  display: block;
}

.question-header {
  min-height: 0;
}

.answer-header {
  min-height: 0;
}

.question-number {
  position: absolute;
  top: 44rpx;
  left: 28rpx;
  padding-top: 0;
  color: #2975a9;
  font-family: "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.favorite-icon,
.round-answer-btn {
  position: absolute;
  top: 30rpx;
  right: 26rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.favorite-icon {
  top: 40rpx;
  right: 36rpx;
  width: 48rpx;
  height: 46rpx;
  background: transparent;
}

.favorite-star {
  width: 48rpx;
  height: 46rpx;
}

.round-answer-btn {
  top: 34rpx;
  right: 20rpx;
  width: 106rpx;
  min-width: 106rpx;
  max-width: 106rpx;
  height: 106rpx;
  min-height: 106rpx;
  max-height: 106rpx;
  color: #ffffff;
  background: #b997f0;
  border-radius: 50%;
  font-family: "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.back-answer-btn {
  background: #2975a9;
}

.question-source {
  margin-top: 0;
}

.source-info {
  color: #2975a9;
  font-family: "PingFang SC", sans-serif;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 50rpx;
}

.question-text {
  margin-top: 16rpx;
  color: #5a5a5a;
  font-family: "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.option-list {
  margin-top: 28rpx;
}

.option-item {
  display: flex;
  align-items: baseline;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #edf1f5;
  color: #333333;
  font-size: 30rpx;
  line-height: 1.5;
}

.option-item.is-saving {
  opacity: 0.6;
}

.option-item-label {
  flex-shrink: 0;
  margin-right: 18rpx;
  color: #2975a9;
  font-size: 26rpx;
  font-weight: 600;
}

.option-item-text {
  flex: 1;
  word-break: break-all;
}

.save-error {
  margin-top: 24rpx;
  color: #b84a42;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.save-retry-btn {
  width: 190rpx;
  height: 60rpx;
  margin-top: 12rpx;
  padding: 0;
  color: #ffffff;
  background: #2975a9;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 60rpx;
}

.save-retry-btn::after {
  border: 0;
}

.feedback {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.35;
  text-align: center;
}

.feedback.is-correct {
  color: #4fbd9e;
}

.feedback.is-wrong {
  color: #ff8c8c;
}

.feedback-symbol {
  margin-right: 18rpx;
  font-size: 46rpx;
  line-height: 1;
}

.answer-copy {
  margin-top: 22rpx;
  color: #5a5a5a;
  font-family: "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: justify;
}
