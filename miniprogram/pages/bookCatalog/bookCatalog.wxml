<view class="catalog-page">
  <view
    class="content-card"
    style="background: {{item.displayAccent}};"
    wx:for="{{contents}}"
    wx:key="id"
  >
    <view class="content-title">{{item.title}}</view>

    <view class="card-actions">
      <button
        class="action-btn"
        data-id="{{item.id}}"
        bindtap="openContent"
      >
        看文本
      </button>
      <button
        class="action-btn"
        data-id="{{item.id}}"
        bindtap="openAudio"
      >
        听配音
      </button>
    </view>
  </view>

  <view class="comment-card">
    <view class="comment-heading">
      <view class="comment-label">我的读后感</view>
      <text wx:if="{{!comment}}" class="comment-guidance">简体中文，文明用语，100-2000字</text>
    </view>
    <view class="comment-target">
      <text class="target-title">当前篇目：{{selectedContentTitle || '请先选择正文'}}</text>
      <text class="target-state {{selectedContentViewed ? 'is-read' : ''}}">
        {{selectedContentViewed ? '已打开正文' : '尚未打开正文'}}
      </text>
    </view>
    <textarea
      class="comment-input"
      value="{{comment}}"
      maxlength="2000"
      bindinput="onCommentInput"
    ></textarea>
    <button
      class="submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submitComment"
    >
      {{reviewPending ? '等待复审' : (submitted ? '提交成功' : (needsRevision ? '改后提交' : '确认提交'))}}
    </button>
  </view>

  <view class="full-book-card" bindtap="openFullBook">
    <view class="full-book-title">
      <image
        class="full-book-logo"
        src="/images/brand/china-hospital-ship-horizontal-bracketed.png"
        mode="aspectFit"
        aria-label="《中国医院船》"
      />
    </view>
    <view class="full-book-status">读后感审核通过后，可阅读全本并下载PDF</view>
  </view>
</view>
