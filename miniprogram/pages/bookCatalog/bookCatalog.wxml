<view class="catalog-page">
  <view
    class="content-card"
    style="background: {{item.displayAccent}};"
    wx:for="{{contents}}"
    wx:key="id"
  >
    <view class="content-title">{{item.title}}</view>
    <button
      class="action-btn text-btn"
      data-id="{{item.id}}"
      bindtap="openContent"
    >
      看文本
    </button>
    <button
      class="action-btn audio-btn"
      data-id="{{item.id}}"
      bindtap="openAudio"
    >
      听配音
    </button>
  </view>

  <view class="comment-card">
    <view class="comment-heading">
      <view class="comment-label">我的读后感</view>
      <text wx:if="{{!comment}}" class="comment-guidance">简体中文，文明用语，50-500字</text>
    </view>
    <textarea
      class="comment-input"
      value="{{comment}}"
      maxlength="2000"
      bindinput="onCommentInput"
    ></textarea>
    <button
      class="submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submitComment"
    >
      {{reviewPending ? '等待复审' : (submitted ? '提交成功' : (needsRevision ? '改后提交' : '确认提交'))}}
    </button>
  </view>

  <view class="full-book-card" bindtap="openFullBook">
    <image
      class="full-book-logo"
      src="/images/brand/china-hospital-ship-horizontal-bracketed.png"
      mode="aspectFit"
      aria-label="《中国医院船》"
    />
    <view class="full-book-status">少年会员提交读后感之后可下载全本</view>
  </view>
</view>
