page {
  background: #f3f3f3;
}

.catalog-page {
  min-height: 100vh;
  padding: 30rpx 40rpx calc(34rpx + env(safe-area-inset-bottom));
  background: #f3f3f3;
  box-sizing: border-box;
}

.content-card {
  position: relative;
  width: 670rpx;
  height: 144rpx;
  margin-bottom: 26rpx;
  color: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.15);
  box-sizing: border-box;
  overflow: hidden;
}

.content-title {
  position: absolute;
  left: 0;
  right: 0;
  top: 20rpx;
  width: 100%;
  height: 58rpx;
  color: #ffffff;
  font-family: "PingFang SC", "PingFang HK", sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 58rpx;
  text-align: center;
  white-space: nowrap;
}

.action-btn {
  position: absolute;
  width: 132rpx;
  min-width: 132rpx;
  max-width: 132rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 8rpx;
  font-family: Roboto, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 44rpx;
  flex-shrink: 0;
  flex-grow: 0;
  box-sizing: border-box;
}

.text-btn {
  left: 28rpx;
  top: 76rpx;
}

.audio-btn {
  right: 28rpx;
  top: 76rpx;
}

.action-btn::after {
  border: none;
}

.comment-card {
  position: relative;
  width: 670rpx;
  height: 350rpx;
  margin-top: 2rpx;
  margin-bottom: 30rpx;
  padding: 0;
  background: #ffffff;
  border: 2rpx solid #cc411a;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.comment-heading {
  display: block;
}

.comment-label {
  position: absolute;
  left: 10rpx;
  top: 12rpx;
  width: 162rpx;
  height: 58rpx;
  padding: 0;
  color: #4d4d4d;
  border: 2rpx solid #cc411a;
  border-radius: 8rpx;
  font-family: Roboto, "PingFang SC", sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 54rpx;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.comment-guidance {
  position: absolute;
  left: 188rpx;
  top: 36rpx;
  color: #aaaaaa;
  font-family: Roboto, "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 44rpx;
  white-space: nowrap;
}

.comment-input {
  position: absolute;
  left: 16rpx;
  top: 76rpx;
  width: 638rpx;
  height: 196rpx;
  margin: 0;
  padding: 0 4rpx;
  color: #333333;
  font-family: "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.comment-target {
  min-width: 0;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #666666;
  font-size: 21rpx;
  line-height: 1.45;
}

.target-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.target-state {
  flex: none;
  color: #a9442d;
}

.target-state.is-read {
  color: #278768;
}

.submit-btn {
  position: absolute;
  right: 12rpx;
  bottom: 14rpx;
  width: 162rpx;
  min-width: 162rpx;
  max-width: 162rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  color: #171717;
  background: #ffffff;
  border: 2rpx solid #cc411a;
  border-radius: 8rpx;
  font-family: "PingFang SC", "PingFang HK", sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 54rpx;
  box-sizing: border-box;
}

.submit-btn::after {
  border: none;
}

.full-book-card {
  width: 670rpx;
  margin-top: 0;
  text-align: center;
}

.full-book-logo {
  width: 670rpx;
  height: 194rpx;
  padding: 0 66rpx;
  background: #cc411a;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.full-book-status {
  display: inline-block;
  margin-top: 14rpx;
  padding-bottom: 4rpx;
  color: #4d4d4d;
  border-bottom: 2rpx solid #cc411a;
  font-family: Roboto, "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
}
