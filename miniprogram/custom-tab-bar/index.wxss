.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  background: #ffffff;
  filter: drop-shadow(0 -8rpx 17rpx rgba(0, 0, 0, 0.2));
}

.tabbar {
  position: relative;
  height: 132rpx;
  display: flex;
  align-items: stretch;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 100%;
}

.tab-icon {
  position: absolute;
  left: 50%;
  display: block;
  object-fit: contain;
  transform: translateX(-50%);
}

.tab-text {
  position: absolute;
  top: 72rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-family: "PingFang SC", STKaiti, KaiTi, serif;
  font-weight: 600;
  line-height: 24rpx;
}

.tab-line {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  height: 4rpx;
  border-radius: 4rpx;
  transform: translateX(-50%);
}

.safe-area {
  height: env(safe-area-inset-bottom);
}
