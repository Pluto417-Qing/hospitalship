.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  background: #ffffff;
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.tabbar {
  height: 150rpx;
  display: flex;
  align-items: stretch;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 5rpx;
  gap: 1rpx;
}

.tab-icon {
  display: block;
  object-fit: contain;
}

.tab-text {
  margin-top: 0;
  font-family: STKaiti, KaiTi, serif;
  font-weight: 600;
  line-height: 1;
}

.tab-line {
  position: absolute;
  bottom: 2rpx;
  height: 4rpx;
  border-radius: 4rpx;
}

.safe-area {
  height: env(safe-area-inset-bottom);
}
