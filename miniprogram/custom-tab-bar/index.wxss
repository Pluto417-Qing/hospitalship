.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  background: #ffffff;
  box-shadow: 0 -8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.tabbar {
  height: 100rpx;
  display: flex;
  align-items: stretch;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 10rpx;
}

.tab-icon {
  width: 55rpx;
  height: 55rpx;
  object-fit: contain;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 18rpx;
  line-height: 24rpx;
}

.tab-line {
  position: absolute;
  bottom: 2rpx;
  width: 56rpx;
  height: 4rpx;
  border-radius: 4rpx;
}

.safe-area {
  height: env(safe-area-inset-bottom);
}
