PORT=8080
CLOUDBASE_ENV_ID=replace-with-your-environment-id

# Prefer the platform runtime/service identity when CloudBase Run is configured
# with the least-privilege role described in README.md.
CLOUDBASE_USE_RUNTIME_IDENTITY=true

# For a non-CloudBase host, inject both values from a secret manager instead.
# Never commit real credentials or return them to the mini program.
# CLOUDBASE_SECRET_ID=
# CLOUDBASE_SECRET_KEY=

UPLOAD_TEMP_DIR=/tmp/admin-upload-broker
REQUEST_TIMEOUT_MS=1800000
